# ==========================================
# SmartTrip - Variáveis de Ambiente (Template)
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA envie .env.local para o controle de versão.
# Este arquivo (.env.example) NÃO deve conter valores reais.
# ==========================================

# Google Gemini AI API Key (obtenha em https://aistudio.google.com/)
# Usado SOMENTE no servidor (Next.js API Route / Vercel Function)
# NÃO adicione prefixo VITE_ — nunca deve ser exposto ao browser
GEMINI_API_KEY=

# -----------------------------------------------
# Firebase Client Configuration
# Obtenha no Console do Firebase → Configurações do Projeto → Seus apps
# Estas variáveis SÃO públicas (prefixo VITE_), mas devem sempre
# ser protegidas pelas Firebase Security Rules no backend.
# -----------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL base da aplicação (ex: http://localhost:3000 em dev, https://smarttrip.vercel.app em prod)
APP_URL=
